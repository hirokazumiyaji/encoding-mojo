        _ = loads("1e")
    with assert_raises(contains="Extra data: line 1 column 2 (char 1)"):
        _ = loads("1e+")
    with assert_raises(contains="Extra data: line 1 column 2 (char 1)"):
        _ = loads("01")
    with assert_raises(contains="Extra data: line 1 column 2 (char 1)"):
        _ = loads("00")
    with assert_raises(contains="Extra data: line 1 column 3 (char 2)"):
        _ = loads("-01")
    with assert_raises(contains="Expecting value: line 1 column 2 (char 1)"):
        _ = loads("[")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("]")
    with assert_raises(contains="Expecting property name enclosed in double quotes: line 1 column 2 (char 1)"):
        _ = loads("{")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("}")
    with assert_raises(contains="Expecting value: line 1 column 2 (char 1)"):
        _ = loads("[,]")
    with assert_raises(contains="Expecting value: line 1 column 4 (char 3)"):
        _ = loads("[1,]")


def test_rejects_like_cpython_002() raises:
    with assert_raises(contains="Expecting ',' delimiter: line 1 column 4 (char 3)"):
        _ = loads("[1 2]")
    with assert_raises(contains="Expecting ',' delimiter: line 1 column 5 (char 4)"):
        _ = loads("[1,2")
    with assert_raises(contains="Expecting ',' delimiter: line 1 column 3 (char 2)"):
        _ = loads("[1;2]")
    with assert_raises(contains="Expecting ':' delimiter: line 1 column 5 (char 4)"):
        _ = loads("{\"a\"")
    with assert_raises(contains="Expecting value: line 1 column 6 (char 5)"):
        _ = loads("{\"a\":}")
    with assert_raises(contains="Expecting property name enclosed in double quotes: line 1 column 8 (char 7)"):
        _ = loads("{\"a\":1,}")
    with assert_raises(contains="Expecting ':' delimiter: line 1 column 6 (char 5)"):
        _ = loads("{\"a\" 1}")
    with assert_raises(contains="Expecting property name enclosed in double quotes: line 1 column 2 (char 1)"):
        _ = loads("{1:2}")
    with assert_raises(contains="Expecting ',' delimiter: line 1 column 7 (char 6)"):
        _ = loads("{\"a\":1")
    with assert_raises(contains="Expecting property name enclosed in double quotes: line 1 column 2 (char 1)"):
        _ = loads("{,}")
    with assert_raises(contains="Unterminated string starting at: line 1 column 1 (char 0)"):
        _ = loads("\"abc")
    with assert_raises(contains="Invalid control character at: line 1 column 3 (char 2)"):
        _ = loads("\"a\nb\"")


def test_rejects_like_cpython_003() raises:
    with assert_raises(contains="Invalid \\escape: line 1 column 3 (char 2)"):
        _ = loads("\"a\\qb\"")
    with assert_raises(contains="Invalid \\uXXXX escape: line 1 column 3 (char 2)"):
        _ = loads("\"\\u12\"")
    with assert_raises(contains="Invalid \\uXXXX escape: line 1 column 3 (char 2)"):
        _ = loads("\"\\uZZZZ\"")
    with assert_raises(contains="Invalid \\uXXXX escape: line 1 column 3 (char 2)"):
        _ = loads("\"\\u\"")
    with assert_raises(contains="Unterminated string starting at: line 1 column 1 (char 0)"):
        _ = loads("\"\\\"")
    with assert_raises(contains="Extra data: line 1 column 5 (char 4)"):
        _ = loads("[1] 2")
    with assert_raises(contains="Extra data: line 1 column 9 (char 8)"):
        _ = loads("{\"a\":1} {}")
    with assert_raises(contains="Extra data: line 1 column 3 (char 2)"):
        _ = loads("1 2")
    with assert_raises(contains="Extra data: line 1 column 5 (char 4)"):
        _ = loads("truefalse")
    with assert_raises(contains="Extra data: line 1 column 11 (char 10)"):
        _ = loads("[[1],[2]] trailing")
    with assert_raises(contains="Expecting value: line 1 column 11 (char 10)"):
        _ = loads("{\"outer\": ")
    with assert_raises(contains="Invalid \\uXXXX escape: line 1 column 17 (char 16)"):
        _ = loads("\"a string with \\u0041")


def test_rejects_like_cpython_004() raises:
    with assert_raises(contains="Expecting value: line 1 column 6 (char 5)"):
        _ = loads("{\"a\":")
    with assert_raises(contains="Invalid \\uXXXX escape: line 1 column 4 (char 3)"):
        _ = loads("[\"\\ud83")
    with assert_raises(contains="Unterminated string starting at: line 1 column 2 (char 1)"):
        _ = loads("{\"ou")
    with assert_raises(contains="Invalid \\uXXXX escape: line 1 column 10 (char 9)"):
        _ = loads("[\"\\ud83d\\ude00")
    with assert_raises(contains="Expecting value: line 1 column 7 (char 6)"):
        _ = loads("{\"a\": ")
    with assert_raises(contains="Unterminated string starting at: line 1 column 1 (char 0)"):
        _ = loads("\"a string with")
