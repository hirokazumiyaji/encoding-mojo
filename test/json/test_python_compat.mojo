        _ = loads("[1, 2.5, true, null, ")
    with assert_raises(contains="Expecting value: line 1 column 39 (char 38)"):
        _ = loads("{\"a\": 1e10, \"b\": -2.5e-3, \"c\": [true, ")


def test_rejects_like_cpython_005() raises:
    with assert_raises(contains="Unterminated string starting at: line 1 column 33 (char 32)"):
        _ = loads("{\"a\": [1, 2, {\"b\": null}], \"c\": \"text")
