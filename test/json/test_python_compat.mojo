        "{\"long long long long long long long long 16\": false, \"back\\\\slash5\": {\"quote\\\"14\": [{\"long long long long long long long long 15\": null, \"\\u65e5\\u672c\\u8a9e11\": 960060.883783038}, {}, []], \"\\u007f del6\": null, \"back\\\\slash16\": [[false, 0.0]]}, \"key5\": {\"a15\": -0.0, \"\\u0000\\u0001\\u001f28\": {\"tab\\there19\": [false], \"\\u0000\\u0001\\u001f17\": false, \"tab\\there0\": \"key\", \"quote\\\"10\": {}}, \"a1\": 630561.4036809495}, \"tab\\there26\": {\"\\u65e5\\u672c\\u8a9e25\": [{\"long long long long long long long long 23\": -9, \"back\\\\slash14\": 1e-300, \"quote\\\"23\": -604575.4078206298}], \"\\u0000\\u0001\\u001f24\": -203312.21907736768, \"long long long long long long long long 2\": [{\"\\u007f del3\": null, \"long long long long long long long long 6\": \"emoji \\ud83d\\ude00\", \"quote\\\"5\": -971129.1729292517, \"back\\\\slash10\": 1e-300}, null]}}",
        "{\"long long long long long long long long 16\":false,\"back\\\\slash5\":{\"quote\\\"14\":[{\"long long long long long long long long 15\":null,\"\\u65e5\\u672c\\u8a9e11\":960060.883783038},{},[]],\"\\u007f del6\":null,\"back\\\\slash16\":[[false,0.0]]},\"key5\":{\"a15\":-0.0,\"\\u0000\\u0001\\u001f28\":{\"tab\\there19\":[false],\"\\u0000\\u0001\\u001f17\":false,\"tab\\there0\":\"key\",\"quote\\\"10\":{}},\"a1\":630561.4036809495},\"tab\\there26\":{\"\\u65e5\\u672c\\u8a9e25\":[{\"long long long long long long long long 23\":-9,\"back\\\\slash14\":1e-300,\"quote\\\"23\":-604575.4078206298}],\"\\u0000\\u0001\\u001f24\":-203312.21907736768,\"long long long long long long long long 2\":[{\"\\u007f del3\":null,\"long long long long long long long long 6\":\"emoji \\ud83d\\ude00\",\"quote\\\"5\":-971129.1729292517,\"back\\\\slash10\":1e-300},null]}}",
        "{\n  \"long long long long long long long long 16\": false,\n  \"back\\\\slash5\": {\n    \"quote\\\"14\": [\n      {\n        \"long long long long long long long long 15\": null,\n        \"\\u65e5\\u672c\\u8a9e11\": 960060.883783038\n      },\n      {},\n      []\n    ],\n    \"\\u007f del6\": null,\n    \"back\\\\slash16\": [\n      [\n        false,\n        0.0\n      ]\n    ]\n  },\n  \"key5\": {\n    \"a15\": -0.0,\n    \"\\u0000\\u0001\\u001f28\": {\n      \"tab\\there19\": [\n        false\n      ],\n      \"\\u0000\\u0001\\u001f17\": false,\n      \"tab\\there0\": \"key\",\n      \"quote\\\"10\": {}\n    },\n    \"a1\": 630561.4036809495\n  },\n  \"tab\\there26\": {\n    \"\\u65e5\\u672c\\u8a9e25\": [\n      {\n        \"long long long long long long long long 23\": -9,\n        \"back\\\\slash14\": 1e-300,\n        \"quote\\\"23\": -604575.4078206298\n      }\n    ],\n    \"\\u0000\\u0001\\u001f24\": -203312.21907736768,\n    \"long long long long long long long long 2\": [\n      {\n        \"\\u007f del3\": null,\n        \"long long long long long long long long 6\": \"emoji \\ud83d\\ude00\",\n        \"quote\\\"5\": -971129.1729292517,\n        \"back\\\\slash10\": 1e-300\n      },\n      null\n    ]\n  }\n}",
