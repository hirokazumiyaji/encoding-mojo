        "[{\"key27\":0.0,\"long long long long long long long long 0\":[{\"back\\\\slash8\":0.3333333333333333},1e+300,[]],\"15\":708135474965777315},2958082157651881086]",
        "[\n  {\n    \"key27\": 0.0,\n    \"long long long long long long long long 0\": [\n      {\n        \"back\\\\slash8\": 0.3333333333333333\n      },\n      1e+300,\n      []\n    ],\n    \"15\": 708135474965777315\n  },\n  2958082157651881086\n]",
