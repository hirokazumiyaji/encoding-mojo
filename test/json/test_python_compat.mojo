        _ = loads("{\"a\": [1, 2, {\"b\": null}], \"c\": \"tex")
    with assert_raises(contains="Expecting value: line 1 column 10 (char 9)"):
        _ = loads("[1, 2.5, t")
    with assert_raises(contains="Unterminated string starting at: line 1 column 1 (char 0)"):
        _ = loads("\"a st")
    with assert_raises(contains="Invalid \\uXXXX escape: line 1 column 4 (char 3)"):
        _ = loads("[\"\\ud83d")
    with assert_raises(contains="Invalid \\uXXXX escape: line 1 column 20 (char 19)"):
        _ = loads("[\"\\ud83d\\ude00\", \"\\u")
    with assert_raises(contains="Invalid \\uXXXX escape: line 1 column 10 (char 9)"):
        _ = loads("[\"\\ud83d\\ude")
    with assert_raises(contains="Expecting ',' delimiter: line 1 column 39 (char 38)"):
        _ = loads("{\"a\": [1, 2, {\"b\": null}], \"c\": \"text\"")
    with assert_raises(contains="Invalid \\uXXXX escape: line 1 column 10 (char 9)"):
        _ = loads("[\"\\ud83d\\ude0")
