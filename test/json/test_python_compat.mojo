    )


def test_matches_cpython_012() raises:
    _check(
        "1e+300",
        "1e+300",
        "1e+300",
        "1e+300",
        "1e+300",
        "1e+300",
    )
    _check(
        "3014810473789228556",
        "3014810473789228556",
        "3014810473789228556",
        "3014810473789228556",
        "3014810473789228556",
        "3014810473789228556",
    )
    _check(
        "[[2, 431584.4868337519, []], 0.3333333333333333]",
        "[[2, 431584.4868337519, []], 0.3333333333333333]",
        "[[2,431584.4868337519,[]],0.3333333333333333]",
        "[\n  [\n    2,\n    431584.4868337519,\n    []\n  ],\n  0.3333333333333333\n]",
        "[[2, 431584.4868337519, []], 0.3333333333333333]",
        "[[2, 431584.4868337519, []], 0.3333333333333333]",
    )
    _check(
        "{}",
        "{}",
        "{}",
        "{}",
        "{}",
        "{}",
    )
    _check(
        "null",
        "null",
        "null",
        "null",
        "null",
        "null",
    )
    _check(
        "-9",
        "-9",
        "-9",
        "-9",
        "-9",
        "-9",
    )
    _check(
        "{\"nl\\nhere18\": \"long long long long long long long long \", \"back\\\\slash1\": [[-542634.8751090267, [-269419601100002088], {\"key25\": true, \"long long long long long long long long 21\": false, \"nl\\nhere7\": 9}], [-2250471023367825234]]}",
        "{\"nl\\nhere18\": \"long long long long long long long long \", \"back\\\\slash1\": [[-542634.8751090267, [-269419601100002088], {\"key25\": true, \"long long long long long long long long 21\": false, \"nl\\nhere7\": 9}], [-2250471023367825234]]}",
        "{\"nl\\nhere18\":\"long long long long long long long long \",\"back\\\\slash1\":[[-542634.8751090267,[-269419601100002088],{\"key25\":true,\"long long long long long long long long 21\":false,\"nl\\nhere7\":9}],[-2250471023367825234]]}",
        "{\n  \"nl\\nhere18\": \"long long long long long long long long \",\n  \"back\\\\slash1\": [\n    [\n      -542634.8751090267,\n      [\n        -269419601100002088\n      ],\n      {\n        \"key25\": true,\n        \"long long long long long long long long 21\": false,\n        \"nl\\nhere7\": 9\n      }\n    ],\n    [\n      -2250471023367825234\n    ]\n  ]\n}",
        "{\"back\\\\slash1\": [[-542634.8751090267, [-269419601100002088], {\"key25\": true, \"long long long long long long long long 21\": false, \"nl\\nhere7\": 9}], [-2250471023367825234]], \"nl\\nhere18\": \"long long long long long long long long \"}",
        "{\"nl\\nhere18\": \"long long long long long long long long \", \"back\\\\slash1\": [[-542634.8751090267, [-269419601100002088], {\"key25\": true, \"long long long long long long long long 21\": false, \"nl\\nhere7\": 9}], [-2250471023367825234]]}",
    )
    _check(
        "[]",
        "[]",
        "[]",
        "[]",
        "[]",
        "[]",
    )
    _check(
        "\"back\\\\slash\"",
        "\"back\\\\slash\"",
        "\"back\\\\slash\"",
        "\"back\\\\slash\"",
        "\"back\\\\slash\"",
        "\"back\\\\slash\"",
    )
    _check(
        "1",
        "1",
        "1",
        "1",
        "1",
        "1",
    )


def test_rejects_like_cpython_000() raises:
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("")
    with assert_raises(contains="Expecting value: line 1 column 4 (char 3)"):
        _ = loads("   ")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("x")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("'a'")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("nul")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("tru")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("fals")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("nan")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("inf")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("-")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads("+1")
    with assert_raises(contains="Expecting value: line 1 column 1 (char 0)"):
        _ = loads(".1")


def test_rejects_like_cpython_001() raises:
    with assert_raises(contains="Extra data: line 1 column 2 (char 1)"):
        _ = loads("1.")
