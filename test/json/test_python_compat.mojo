        "[\n  \"a\",\n  \"b\"\n]",
        "[\"a\", \"b\"]",
        "[\"a\", \"b\"]",
    )


def test_matches_cpython_005() raises:
    _check(
        "[[]]",
        "[[]]",
        "[[]]",
        "[\n  []\n]",
        "[[]]",
        "[[]]",
    )
    _check(
        "[[[[[]]]]]",
        "[[[[[]]]]]",
        "[[[[[]]]]]",
        "[\n  [\n    [\n      [\n        []\n      ]\n    ]\n  ]\n]",
        "[[[[[]]]]]",
        "[[[[[]]]]]",
    )
    _check(
        "[null,true,false,1,1.5,\"s\",[],{}]",
        "[null, true, false, 1, 1.5, \"s\", [], {}]",
        "[null,true,false,1,1.5,\"s\",[],{}]",
        "[\n  null,\n  true,\n  false,\n  1,\n  1.5,\n  \"s\",\n  [],\n  {}\n]",
        "[null, true, false, 1, 1.5, \"s\", [], {}]",
        "[null, true, false, 1, 1.5, \"s\", [], {}]",
    )
    _check(
        "{\"a\":1}",
        "{\"a\": 1}",
        "{\"a\":1}",
        "{\n  \"a\": 1\n}",
        "{\"a\": 1}",
        "{\"a\": 1}",
    )
    _check(
        "{\"a\":1,\"b\":2}",
        "{\"a\": 1, \"b\": 2}",
        "{\"a\":1,\"b\":2}",
        "{\n  \"a\": 1,\n  \"b\": 2\n}",
        "{\"a\": 1, \"b\": 2}",
        "{\"a\": 1, \"b\": 2}",
    )
    _check(
        "{\"\":1}",
        "{\"\": 1}",
        "{\"\":1}",
        "{\n  \"\": 1\n}",
        "{\"\": 1}",
        "{\"\": 1}",
    )
    _check(
        "{\"a\":{\"b\":{\"c\":1}}}",
        "{\"a\": {\"b\": {\"c\": 1}}}",
        "{\"a\":{\"b\":{\"c\":1}}}",
        "{\n  \"a\": {\n    \"b\": {\n      \"c\": 1\n    }\n  }\n}",
        "{\"a\": {\"b\": {\"c\": 1}}}",
        "{\"a\": {\"b\": {\"c\": 1}}}",
    )
    _check(
        "{\"a\":[1,2],\"b\":{\"c\":[3,{\"d\":null}]}}",
        "{\"a\": [1, 2], \"b\": {\"c\": [3, {\"d\": null}]}}",
        "{\"a\":[1,2],\"b\":{\"c\":[3,{\"d\":null}]}}",
        "{\n  \"a\": [\n    1,\n    2\n  ],\n  \"b\": {\n    \"c\": [\n      3,\n      {\n        \"d\": null\n      }\n    ]\n  }\n}",
        "{\"a\": [1, 2], \"b\": {\"c\": [3, {\"d\": null}]}}",
        "{\"a\": [1, 2], \"b\": {\"c\": [3, {\"d\": null}]}}",
    )
    _check(
        "{\"a\":1,\"a\":2}",
        "{\"a\": 2}",
        "{\"a\":2}",
        "{\n  \"a\": 2\n}",
        "{\"a\": 2}",
        "{\"a\": 2}",
    )
    _check(
        "{\"a\":1,\"b\":2,\"a\":3}",
        "{\"a\": 3, \"b\": 2}",
        "{\"a\":3,\"b\":2}",
        "{\n  \"a\": 3,\n  \"b\": 2\n}",
        "{\"a\": 3, \"b\": 2}",
        "{\"a\": 3, \"b\": 2}",
    )
    _check(
        "{\"dup\":1,\"x\":0,\"dup\":2,\"y\":0,\"dup\":3}",
        "{\"dup\": 3, \"x\": 0, \"y\": 0}",
        "{\"dup\":3,\"x\":0,\"y\":0}",
        "{\n  \"dup\": 3,\n  \"x\": 0,\n  \"y\": 0\n}",
        "{\"dup\": 3, \"x\": 0, \"y\": 0}",
        "{\"dup\": 3, \"x\": 0, \"y\": 0}",
    )
    _check(
        "  [ 1 , 2 ]  ",
        "[1, 2]",
        "[1,2]",
        "[\n  1,\n  2\n]",
        "[1, 2]",
        "[1, 2]",
    )


