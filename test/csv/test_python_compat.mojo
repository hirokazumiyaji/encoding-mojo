def test_strict_rejects_like_python_000() raises:
    with assert_raises():
        _ = reader('"a"b,c\n', Dialect(strict=True))
    with assert_raises():
        _ = reader('"a', Dialect(strict=True))
    with assert_raises():
        _ = reader('"a\n', Dialect(strict=True))
    with assert_raises():
        _ = reader('"a"x\n', Dialect(strict=True))


