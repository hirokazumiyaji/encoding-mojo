def test_matches_python_014() raises:
    _check(
        "a,b\n\nc,d\n",
        Dialect(quoting=QUOTE_ALL),
        "[['a', 'b'], [], ['c', 'd']]",
        '"a","b"\r\n\r\n"c","d"\r\n',
    )
    _check(
        "a,b\n\nc,d\n",
        Dialect(lineterminator="\n"),
        "[['a', 'b'], [], ['c', 'd']]",
        "a,b\n\nc,d\n",
    )
    _check(
        "a,b\n\nc,d\n",
        Dialect(delimiter="\u20ac"),
        "[['a,b'], [], ['c,d']]",
        "a,b\r\n\r\nc,d\r\n",
    )
    _check(
        ",,\n",
        Dialect(),
        "[['', '', '']]",
        ",,\r\n",
    )
    _check(
        ",,\n",
        excel_tab(),
        "[[',,']]",
        ",,\r\n",
    )
    _check(
        ",,\n",
        unix(),
        "[['', '', '']]",
        '"","",""\n',
    )


