        "a,b,c\n1,2,3\n",
    )
    _check(
        "a,b,c\n1,2,3\n",
        Dialect(delimiter="\u20ac"),
        "[['a,b,c'], ['1,2,3']]",
        "a,b,c\r\n1,2,3\r\n",
    )
    _check(
        "a,b\n1,2",
        Dialect(),
        "[['a', 'b'], ['1', '2']]",
        "a,b\r\n1,2\r\n",
    )
    _check(
        "a,b\n1,2",
        excel_tab(),
        "[['a,b'], ['1,2']]",
        "a,b\r\n1,2\r\n",
    )
    _check(
        "a,b\n1,2",
        unix(),
        "[['a', 'b'], ['1', '2']]",
        '"a","b"\n"1","2"\n',
