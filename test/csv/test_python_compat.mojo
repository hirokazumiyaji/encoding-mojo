def test_matches_python_249() raises:
    _check(
        "2.5|a|a\\ba;|;inf\n",
        Dialect(delimiter="\u20ac"),
        "[['2.5|a|a\\ba;|;inf']]",
        "2.5|a|a\\ba;|;inf\r\n",
    )
    _check(
        'a\\b;a b;inf\nx"y|"q"|""café;-3e2\n\n',
        Dialect(),
        '[[\'a\\b;a b;inf\'], [\'x"y|"q"|""café;-3e2\'], []]',
        'a\\b;a b;inf\r\n"x""y|""q""|""""café;-3e2"\r\n\r\n',
    )
    _check(
        'a\\b;a b;inf\nx"y|"q"|""café;-3e2\n\n',
        excel_tab(),
        '[[\'a\\b;a b;inf\'], [\'x"y|"q"|""café;-3e2\'], []]',
        'a\\b;a b;inf\r\n"x""y|""q""|""""café;-3e2"\r\n\r\n',
    )
    _check(
        'a\\b;a b;inf\nx"y|"q"|""café;-3e2\n\n',
        unix(),
        '[[\'a\\b;a b;inf\'], [\'x"y|"q"|""café;-3e2\'], []]',
        '"a\\b;a b;inf"\n"x""y|""q""|""""café;-3e2"\n\n',
    )
    _check(
        'a\\b;a b;inf\nx"y|"q"|""café;-3e2\n\n',
        Dialect(delimiter=";"),
        "[['a\\b', 'a b', 'inf'], ['x\"y|\"q\"|\"\"café', '-3e2'], []]",
        'a\\b;a b;inf\r\n"x""y|""q""|""""café";-3e2\r\n\r\n',
    )
    _check(
        'a\\b;a b;inf\nx"y|"q"|""café;-3e2\n\n',
        Dialect(delimiter="|"),
        "[['a\\b;a b;inf'], ['x\"y', 'q', 'café;-3e2'], []]",
        'a\\b;a b;inf\r\n"x""y"|q|café;-3e2\r\n\r\n',
    )


