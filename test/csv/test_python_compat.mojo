        Dialect(quoting=QUOTE_NONNUMERIC),
        "[['', '']]",
        '"",""\r\n',
    )
    _check(
        ',""\n',
        Dialect(delimiter="\n"),
        "[[',\"\"']]",
        '","""""\r\n',
    )
    _check(
        ',""\n',
        Dialect(escapechar="\r"),
        "[['', '']]",
        ",\r\n",
    )
    _check(
        "1,\n",
        Dialect(),
        "[['1', '']]",
        "1,\r\n",
    )


