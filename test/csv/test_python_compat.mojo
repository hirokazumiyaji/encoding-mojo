        (
            "[['id', 'name', 'note'], ['1', 'alice', 'says \"hi\"'], ['2',"
            " 'bob', 'two\nlines'], ['3', 'carol', '']]"
        ),
        (
            '"id","name","note"\r\n"1","alice","says'
