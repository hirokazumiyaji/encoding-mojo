        "[['2.5'], ['€', 'a,b'], ['\\,\x00,-3e2']]",
        "2.5\r\n€;a,b\r\n\\,\x00,-3e2\r\n",
    )
    _check(
        '2.5\r€;"a,b"\r\\,\x00,-3e2\r',
        Dialect(delimiter="|"),
        "[['2.5'], ['€;\"a,b\"'], ['\\,\x00,-3e2']]",
        '2.5\r\n"€;""a,b"""\r\n\\,\x00,-3e2\r\n',
    )
    _check(
        '2.5\r€;"a,b"\r\\,\x00,-3e2\r',
        Dialect(skipinitialspace=True),
        "[['2.5'], ['€;\"a', 'b\"'], ['\\', '\x00', '-3e2']]",
        '2.5\r\n"€;""a","b"""\r\n\\,\x00,-3e2\r\n',
    )
    _check(
        '2.5\r€;"a,b"\r\\,\x00,-3e2\r',
        Dialect(quotechar="'"),
        "[['2.5'], ['€;\"a', 'b\"'], ['\\', '\x00', '-3e2']]",
        '2.5\r\n€;"a,b"\r\n\\,\x00,-3e2\r\n',
    )
    _check(
        '2.5\r€;"a,b"\r\\,\x00,-3e2\r',
        Dialect(escapechar="\\"),
        "[['2.5'], ['€;\"a', 'b\"'], [',\x00', '-3e2']]",
        '2.5\r\n"€;""a","b"""\r\n",\x00",-3e2\r\n',
    )
    _check(
        '2.5\r€;"a,b"\r\\,\x00,-3e2\r',
        Dialect(doublequote=False, escapechar="\\"),
        "[['2.5'], ['€;\"a', 'b\"'], [',\x00', '-3e2']]",
        '2.5\r\n€;\\"a,b\\"\r\n",\x00",-3e2\r\n',
    )


def test_matches_python_227() raises:
