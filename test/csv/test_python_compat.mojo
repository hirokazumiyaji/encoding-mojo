    )


def test_matches_python_014() raises:
    _check(
        "a,b\n\nc,d\n",
        excel_tab(),
        "[['a,b'], [], ['c,d']]",
        "a,b\r\n\r\nc,d\r\n",
    )
    _check(
        "a,b\n\nc,d\n",
        unix(),
        "[['a', 'b'], [], ['c', 'd']]",
        '"a","b"\n\n"c","d"\n',
    )
    _check(
        "a,b\n\nc,d\n",
        Dialect(delimiter=";"),
        "[['a,b'], [], ['c,d']]",
        "a,b\r\n\r\nc,d\r\n",
    )
    _check(
        "a,b\n\nc,d\n",
        Dialect(delimiter="|"),
        "[['a,b'], [], ['c,d']]",
        "a,b\r\n\r\nc,d\r\n",
    )
    _check(
        "a,b\n\nc,d\n",
        Dialect(skipinitialspace=True),
        "[['a', 'b'], [], ['c', 'd']]",
        "a,b\r\n\r\nc,d\r\n",
    )
    _check(
        "a,b\n\nc,d\n",
        Dialect(quotechar="'"),
        "[['a', 'b'], [], ['c', 'd']]",
        "a,b\r\n\r\nc,d\r\n",
    )


