            ' """"hi"""""""\r\n"2,bob,""two"\r\n"lines"""\r\n3,carol,\r\n'
        ),
    )
    _check(
        "a,b\r\nc,d\n\ne,f\r",
        Dialect(),
        "[['a', 'b'], ['c', 'd'], [], ['e', 'f']]",
        "a,b\r\nc,d\r\n\r\ne,f\r\n",
    )


