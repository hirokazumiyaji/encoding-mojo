    _check(
        '"a\nb";,;日本\n',
        Dialect(quoting=QUOTE_ALL),
        "[['a\nb;', ';日本']]",
        '"a\nb;",";日本"\r\n',
    )
    _check(
        '"a\nb";,;日本\n',
        Dialect(lineterminator="\n"),
        "[['a\nb;', ';日本']]",
        '"a\nb;",;日本\n',
    )
    _check(
        '"a\nb";,;日本\n',
        Dialect(delimiter="\u20ac"),
        "[['a\nb;,;日本']]",
        '"a\nb;,;日本"\r\n',
    )


