def test_matches_python_197() raises:
    _check(
        ',""\na\\;日本;a b\r\na\\b;2.5\r',
        Dialect(),
        "[['', ''], ['a\\;日本;a b'], ['a\\b;2.5']]",
        ",\r\na\\;日本;a b\r\na\\b;2.5\r\n",
    )
    _check(
        ',""\na\\;日本;a b\r\na\\b;2.5\r',
        excel_tab(),
        "[[',\"\"'], ['a\\;日本;a b'], ['a\\b;2.5']]",
        '","""""\r\na\\;日本;a b\r\na\\b;2.5\r\n',
    )
    _check(
        ',""\na\\;日本;a b\r\na\\b;2.5\r',
        unix(),
        "[['', ''], ['a\\;日本;a b'], ['a\\b;2.5']]",
        '"",""\n"a\\;日本;a b"\n"a\\b;2.5"\n',
    )
    _check(
        ',""\na\\;日本;a b\r\na\\b;2.5\r',
        Dialect(delimiter=";"),
        "[[',\"\"'], ['a\\', '日本', 'a b'], ['a\\b', '2.5']]",
        '","""""\r\na\\;日本;a b\r\na\\b;2.5\r\n',
    )
    _check(
        ',""\na\\;日本;a b\r\na\\b;2.5\r',
        Dialect(delimiter="|"),
        "[[',\"\"'], ['a\\;日本;a b'], ['a\\b;2.5']]",
        '","""""\r\na\\;日本;a b\r\na\\b;2.5\r\n',
    )
    _check(
        ',""\na\\;日本;a b\r\na\\b;2.5\r',
        Dialect(skipinitialspace=True),
        "[['', ''], ['a\\;日本;a b'], ['a\\b;2.5']]",
        ",\r\na\\;日本;a b\r\na\\b;2.5\r\n",
    )


