        ),
        (
            'id,name,note\r\n1,alice,\\"says'
            ' \\"\\"hi\\"\\"\\"\r\n2,bob,\\"two\r\nlines\\"\r\n3,carol,\r\n'
        ),
    )
    _check(
        'id,name,note\n1,alice,"says ""hi"""\n2,bob,"two\nlines"\n3,carol,\n',
